# Gradle / Android 构建产物（务必忽略，否则会传上几百 MB 的 .dex/.class）
.gradle/
build/
**/build/
local.properties
captures/
.externalNativeBuild/
.cxx/

# IDE
*.iml
.idea/

# 系统 / 临时
.DS_Store
*.log

# 构建产物：APK 不入库（发布走 GitHub Releases）
*.apk
*.aab

# 本地诊断工作区（反汇编 / 日志抓包，单目录百 MB 级，绝不入库）
work_diag_*/

# 逐轮「断言式补丁脚本」的备份目录（本地证据快照，绝不入库）
#   每个 _backup_<轮次>/ 里是当轮改动**之前**的原文件副本，只用于 --revert / 事后复核。
#   不加这条时，它们会一直以「未跟踪」形态堆在仓库里 —— 一次 `git add -A` 就会被整批推上去。
_backup_*/

# 各轮的**一次性**补丁 / 探针脚本（`_` 前缀即「只在本机有意义」）
#   它们是「那一轮怎么改的」的现场记录，但依赖当轮的工作区与备份目录，不具备可重跑性；
#   真正入库的是 `verify_*.py`（判据）与 `tools/audit_arch.py`（体检入口）。
#   2026-11-03 起这 64 个脚本已**物理归档**到 tools/archive/patches/，故该目录整体忽略。
tools/_*.py
tools/archive/patches/

# Python 字节码缓存
__pycache__/

# 注意：gradle.properties 是构建必需（android.useAndroidX 等），不要忽略，需纳入版本库

# 各轮发版的一次性工作目录（notes / 远端克隆 / bot 轮询快照）
_rel*/

# 本地诊断工作区（结构分析 / 审计 / 变异测试的中间产物与日志）
#   与 work_diag_*/ 同类：只在本机有意义，绝不入库。
_diag_*/
